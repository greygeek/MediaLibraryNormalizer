<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MediaLibraryNormalizer.Desktop.App"
             xmlns:local="using:MediaLibraryNormalizer.Desktop"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="avares://MediaLibraryNormalizer.Desktop/Themes/Light.axaml"/>
                <ResourceInclude x:Key="Dark" Source="avares://MediaLibraryNormalizer.Desktop/Themes/Dark.axaml"/>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Window: themed background -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Default text colors -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Navigation buttons: pill-shaped -->
        <Style Selector="WrapPanel > Button">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource NavButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NavButtonFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="WrapPanel > Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavButtonHoverBgBrush}"/>
        </Style>

        <!-- Accent buttons: primary gradient -->
        <Style Selector="Button.accent">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}"/>
        </Style>

        <!-- General controls: rounded corners (per theme spec) -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Cards: surface color, border, rounded -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Header bar -->
        <Style Selector="Border.headerBar">
            <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <!-- Stat cards: shared base -->
        <Style Selector="Border.statCard">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.statCard TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Stat card color variants using gradient brushes -->
        <Style Selector="Border.statCardBlue">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource StatBlueStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource StatBlueEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.statCardGreen">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource StatGreenStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource StatGreenEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.statCardOrange">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource StatOrangeStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource StatOrangeEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.statCardPink">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource StatPinkStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource StatPinkEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.statCardPurple">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource StatPurpleStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource StatPurpleEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.statCardCyan">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource StatCyanStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource StatCyanEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chart cards -->
        <Style Selector="Border.chartCard">
            <Setter Property="Background" Value="{DynamicResource ChartCardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ChartCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <!-- Status pills -->
        <Style Selector="Border.statusPill">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style Selector="Border.statusPill TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.statusSuccess">
            <Setter Property="Background" Value="{DynamicResource StatusSuccessBrush}"/>
        </Style>
        <Style Selector="Border.statusWarning">
            <Setter Property="Background" Value="{DynamicResource StatusWarningBrush}"/>
        </Style>
        <Style Selector="Border.statusError">
            <Setter Property="Background" Value="{DynamicResource StatusErrorBrush}"/>
        </Style>
        <Style Selector="Border.statusSuccess TextBlock, Border.statusWarning TextBlock, Border.statusError TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ListBox: transparent background -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Application.Styles>
</Application>