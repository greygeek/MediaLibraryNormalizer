<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaLibraryNormalizer.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="MediaLibraryNormalizer.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
    Title="Media Library Normalizer"
    Width="1400"
    Height="900"
    MinWidth="1100"
    MinHeight="700">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <Border Grid.Row="0" Padding="20" CornerRadius="12" Background="{DynamicResource SystemControlAcrylicWindowBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Media Library Normalizer" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ActiveWorkspaceTitle}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveWorkspaceDescription}" Opacity="0.78" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Command="{Binding NavigateHomeCommand}" Content="Home" Margin="0,0,8,8"/>
                    <Button Command="{Binding NavigateToMergeManagerCommand}" Content="Merge Manager" Margin="0,0,8,8"/>
                    <Button Command="{Binding NavigateToMissingEpisodeFinderCommand}" Content="Missing Episode Finder" Margin="0,0,0,8"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="Library Path" FontWeight="SemiBold"/>
                <TextBox Text="{Binding LibraryPath}" Watermark="F:\TV or another library root"/>
                <TextBlock Text="{Binding HomeStatusSummary}" Opacity="0.72" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <ScrollViewer IsVisible="{Binding IsHomePageActive}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
                        <Border Grid.Column="0" Padding="20" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Desktop Hub" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="One shell, multiple workflows. Use the existing merge manager for cleanup operations or launch the new audit workspace to track collection completeness." TextWrapping="Wrap" Opacity="0.8"/>
                                <TextBlock Text="{Binding HomeStatusSummary}" TextWrapping="Wrap" Opacity="0.72"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="20" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Roadmap" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Phase 1: landing page and navigation shell." Opacity="0.78"/>
                                <TextBlock Text="Phase 2: online metadata providers, reconciliation engine, and missing-episode reports." Opacity="0.78" TextWrapping="Wrap"/>
                                <TextBlock Text="Future workflows can be added as more tiles without replacing the shell again." Opacity="0.72" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Padding="20" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Merge Manager" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MergeManagerTileSummary}" TextWrapping="Wrap" Opacity="0.8"/>
                                <TextBlock Text="Current implementation" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="Review duplicate groups, stage approvals, inspect planned operations, and run live merges." TextWrapping="Wrap" Opacity="0.72"/>
                                <Button Command="{Binding NavigateToMergeManagerCommand}" Content="Launch Merge Manager" Classes="accent" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="20" CornerRadius="16" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Missing Episode Finder" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MissingEpisodeFinderTileSummary}" TextWrapping="Wrap" Opacity="0.8"/>
                                <TextBlock Text="Current implementation" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="Workspace shell and navigation are ready. Catalog providers, comparison logic, and reports are the next increment." TextWrapping="Wrap" Opacity="0.72"/>
                                <Button Command="{Binding NavigateToMissingEpisodeFinderCommand}" Content="Open Missing Episode Finder" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid IsVisible="{Binding IsMergeManagerActive}" RowDefinitions="Auto,Auto,*" RowSpacing="16">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                        <TextBlock Text="Merge Controls" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Text="Use the existing normalization pipeline from this workspace." Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" Spacing="8" VerticalAlignment="Bottom">
                        <Button Command="{Binding PreviewCommand}" Content="Run Dry Run" MinWidth="140"/>
                        <Button Command="{Binding MergeCommand}" Content="Run Approved Live Merge" MinWidth="200" Classes="accent"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0" ItemWidth="220" Orientation="Horizontal">
                        <CheckBox Content="Exact matches with files only" IsChecked="{Binding ExactMatchesWithFilesOnly}" Margin="0,0,16,8"/>
                        <CheckBox Content="Discard inferior duplicates" IsChecked="{Binding DiscardInferiorDuplicates}" Margin="0,0,16,8"/>
                        <CheckBox Content="Use AI verification" IsChecked="{Binding UseAi}" Margin="0,0,16,8"/>
                        <CheckBox Content="Use hashing" IsChecked="{Binding UseHash}" Margin="0,0,16,8"/>
                        <CheckBox Content="Verbose logging" IsChecked="{Binding Verbose}" Margin="0,0,16,8"/>
                        <CheckBox Content="Delete sample files" IsChecked="{Binding DeleteSamples}" Margin="0,0,16,8"/>
                        <CheckBox Content="Delete unparsed files" IsChecked="{Binding DeleteNonEpisodeFiles}" Margin="0,0,16,8"/>
                    </WrapPanel>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Text="{Binding LastRunSummary}" Opacity="0.75"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Mode" Opacity="0.7"/>
                            <TextBlock Text="{Binding LastRunMode}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Folders" Opacity="0.7"/>
                            <TextBlock Text="{Binding TotalFolders}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Duplicate Groups" Opacity="0.7"/>
                            <TextBlock Text="{Binding DuplicateGroupCount}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedDuplicateGroupCount, StringFormat='Eligible {0}'}" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Approved Groups" Opacity="0.7"/>
                            <TextBlock Text="{Binding ApprovedDuplicateGroupCount}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Errors" Opacity="0.7"/>
                            <TextBlock Text="{Binding ErrorCount}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TabControl Grid.Row="2">
            <TabItem Header="Summary">
                <Grid Margin="0,12,0,0" RowDefinitions="*">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Run Output" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="{Binding ReportPath}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TransactionLogPath}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Additional Metrics" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="{Binding TotalFiles, StringFormat='Video files: {0}'}"/>
                                <TextBlock Text="{Binding UnpackFolderCount, StringFormat='UNPACK folders: {0}'}"/>
                                <TextBlock Text="{Binding EmptyFolderCount, StringFormat='Empty folders: {0}'}"/>
                                <TextBlock Text="{Binding ApprovedCleanupFolderCount, StringFormat='Approved-folder cleanup: {0}'}"/>
                                <TextBlock Text="{Binding GlobalCleanupSweepFolderCount, StringFormat='Global cleanup sweep: {0}'}"/>
                                <TextBlock Text="{Binding CleanupSummary}" Opacity="0.72" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Review &amp; Approval">
                <Grid Margin="0,12,0,0" ColumnDefinitions="2*,3*" ColumnSpacing="16" MinHeight="0">
                    <Border Grid.Column="0" Padding="8" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" MinHeight="0">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="{Binding DuplicateGroupsHeader}" Margin="8" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Margin="8,0,8,8" Text="{Binding ReviewQueueSummary}" Opacity="0.75" TextWrapping="Wrap"/>
                            <WrapPanel Grid.Row="2" Margin="8,0,8,8" Orientation="Horizontal">
                                <Button Command="{Binding ApproveSelectedGroupCommand}" Content="Approve selected" Margin="0,0,8,8"/>
                                <Button Command="{Binding RemoveSelectedGroupCommand}" Content="Remove selected" Margin="0,0,8,8"/>
                                <Button Command="{Binding ApproveAllActionableCommand}" Content="Approve all eligible" Margin="0,0,8,8"/>
                                <Button Command="{Binding ClearApprovedGroupsCommand}" Content="Clear approvals" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <ListBox Grid.Row="3" MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedDuplicateGroup}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                                        <Border Margin="4" Padding="8" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <Border DockPanel.Dock="Right" Padding="8,2" CornerRadius="999" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding ReviewStatus}" FontSize="11"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="{Binding MatchSummary}" Opacity="0.78" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding EligibilitySummary}" FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding IssueSummary}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DuplicateSummary}" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" MinHeight="0">
                        <Grid RowDefinitions="*" MinHeight="0">
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12">
                                <TextBlock Text="{Binding SelectedGroupTitle}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedGroupMatchSummary}" Opacity="0.78" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedGroupReviewStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedGroupEligibilitySummary}" Opacity="0.72" TextWrapping="Wrap"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding ApproveSelectedGroupCommand}" Content="Approve for live merge" Margin="0,0,8,8"/>
                                    <Button Command="{Binding RemoveSelectedGroupCommand}" Content="Remove from queue" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedGroupCanonicalSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedGroupCanonicalPath}" Opacity="0.7" TextWrapping="Wrap"/>

                                <TextBlock Text="Duplicate folders" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                                <ItemsControl ItemsSource="{Binding SelectedGroupDuplicates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FolderItemViewModel">
                                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding FileCountText}" Opacity="0.75"/>
                                                    <TextBlock Text="{Binding Path}" Opacity="0.65" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Folder-level issues" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedGroupIssuesSummary}" Opacity="0.72" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding SelectedGroupIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReviewIssueViewModel">
                                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding FolderPath}" Opacity="0.75" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Operations">
                <Grid Margin="0,12,0,0" RowDefinitions="*" MinHeight="0">
                    <Border Grid.Row="0" Padding="8" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" MinHeight="0">
                        <ListBox MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding Operations}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OperationItemViewModel">
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Source}" Opacity="0.7" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Destination}" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Activity">
                <Grid Margin="0,12,0,0" RowDefinitions="*" MinHeight="0">
                    <Border Grid.Row="0" Padding="8" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" MinHeight="0">
                        <ListBox MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding ActivityLog}"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Errors">
                <Grid Margin="0,12,0,0" RowDefinitions="*" MinHeight="0">
                    <Border Grid.Row="0" Padding="8" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" MinHeight="0">
                        <ListBox MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding ReviewIssues}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReviewIssueViewModel">
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Summary}" Opacity="0.85" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding FolderPath}" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
                </TabControl>
            </Grid>

            <Grid IsVisible="{Binding IsMissingEpisodeFinderActive}" RowDefinitions="Auto,Auto,*" RowSpacing="12">

                <!-- Status bar: summary + action buttons -->
                <Border Grid.Row="0" Padding="12,8" CornerRadius="10"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto">
                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{Binding MissingEpisodeFinder.RunInventoryCommand}" Content="Run Audit"/>
                                <Button Command="{Binding MissingEpisodeFinder.CancelInventoryCommand}" Content="Cancel"
                                        IsVisible="{Binding MissingEpisodeFinder.IsBusy}"
                                        ToolTip.Tip="Cancel the running audit"/>
                                <Button Command="{Binding MissingEpisodeFinder.LoadLastRunCommand}" Content="Load Last Run"
                                        IsVisible="{Binding MissingEpisodeFinder.HasLastSavedRun}"
                                        ToolTip.Tip="{Binding MissingEpisodeFinder.LastSavedRunDate, StringFormat='Saved: {0}'}"/>
                                <Button Command="{Binding MissingEpisodeFinder.ClearInventoryCommand}" Content="Clear"/>
                            </StackPanel>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MissingEpisodeFinder.RunSummaryLine}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Opacity="0.65"
                                           IsVisible="{Binding MissingEpisodeFinder.HasLastSavedRun}"
                                           Text="{Binding MissingEpisodeFinder.LastSavedRunDate, StringFormat='Saved: {0}'}"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- Progress bar + status message: visible only while a run is in progress -->
                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,6,0,0"
                              IsVisible="{Binding MissingEpisodeFinder.IsBusy}">
                            <ProgressBar Grid.Row="0"
                                         IsIndeterminate="{Binding MissingEpisodeFinder.IsAuditProgressIndeterminate}"
                                         Maximum="{Binding MissingEpisodeFinder.AuditProgressMax}"
                                         Value="{Binding MissingEpisodeFinder.AuditProgressValue}"
                                         Height="4" CornerRadius="2"/>
                            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="11" Opacity="0.7"
                                       Text="{Binding MissingEpisodeFinder.StatusMessage}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Settings Expander: auto-collapses once a run is loaded -->
                <Expander Grid.Row="1" Header="Settings"
                          IsExpanded="{Binding MissingEpisodeFinder.IsAuditControlsExpanded}">
                    <Border Padding="16,12" CornerRadius="0,0,10,10"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1,0,1,1">
                        <WrapPanel ItemWidth="220" Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="Catalog Provider" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox MinWidth="180" ItemsSource="{Binding MissingEpisodeFinder.CatalogProviders}" SelectedItem="{Binding MissingEpisodeFinder.SelectedCatalogProvider}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8"
                                        IsVisible="{Binding MissingEpisodeFinder.IsTheTvdbSelected}">
                                <TextBlock Text="TheTVDB API Key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MissingEpisodeFinder.TheTvdbApiKey}"
                                         PasswordChar="&#x2022;"
                                         Watermark="thetvdb.com/api-information (free UUID key)"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="NZBPlanet API Key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0"
                                            Command="{Binding MissingEpisodeFinder.CheckUsenetCommand}"
                                            Content="Check Usenet"
                                            IsVisible="{Binding MissingEpisodeFinder.IsNzbConfigured}"/>
                                    <TextBox Text="{Binding MissingEpisodeFinder.NzbApiKey}" PasswordChar="&#x2022;" Watermark="nzbplanet.net (optional)"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="SABnzbd Watch Folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MissingEpisodeFinder.NzbWatchFolder}" Watermark="e.g. F:\NZB\Watch"/>
                            </StackPanel>
                            <CheckBox Content="Verbose logging" IsChecked="{Binding MissingEpisodeFinder.Verbose}" Margin="0,0,16,8"/>
                            <CheckBox Content="Include specials" IsChecked="{Binding MissingEpisodeFinder.IncludeSpecials}" Margin="0,0,16,8"/>
                        </WrapPanel>
                    </Border>
                </Expander>

                <!-- Series list + detail: independently scrollable, fills available height -->
                <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="16" MinHeight="0">
                    <Border Grid.Column="0" Padding="8" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" MinHeight="0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="Series Inventory" Margin="8" FontSize="18" FontWeight="Bold"/>
                            <CheckBox Grid.Row="1" Margin="8,0,8,8" Content="Show only series with missing episodes" IsChecked="{Binding MissingEpisodeFinder.ShowOnlyMissingEpisodes}"/>
                            <ListBox Grid.Row="2" MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding MissingEpisodeFinder.FilteredSeries}" SelectedItem="{Binding MissingEpisodeFinder.SelectedSeries}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SeriesAuditItemViewModel">
                                        <Border Margin="4" Padding="8" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayTitle}" FontWeight="SemiBold"/>
                                                    <Border DockPanel.Dock="Right" Padding="8,2" CornerRadius="999" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="{Binding InventorySummary}" Opacity="0.78" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CatalogSummary}" FontSize="12" Opacity="0.78" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding IssueSummary}" FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Padding="16" CornerRadius="12" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" MinHeight="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeriesTitle}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>

                                <!-- Per-series action buttons -->
                                <WrapPanel Orientation="Horizontal">
                                    <Button Margin="0,0,8,4"
                                            Command="{Binding MissingEpisodeFinder.QueueMissingDownloadsCommand}"
                                            Content="Queue Missing Downloads"
                                            ToolTip.Tip="{Binding MissingEpisodeFinder.QueueMissingDownloadsToolTip}"/>
                                    <Button Margin="0,0,0,4"
                                            Command="{Binding MissingEpisodeFinder.PendingDeleteSeriesCommand}"
                                            IsVisible="{Binding MissingEpisodeFinder.IsPendingDelete, Converter={x:Static BoolConverters.Not}}"
                                            Content="Delete Series"
                                            ToolTip.Tip="Permanently delete all files and folders for this series and remove it from the database"/>
                                </WrapPanel>

                                <!-- Delete confirmation banner -->
                                <Border IsVisible="{Binding MissingEpisodeFinder.IsPendingDelete}"
                                        Padding="12" CornerRadius="10"
                                        BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1"
                                        Background="#40E04444">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="This will permanently delete all files and folders on disk and cannot be undone."
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Command="{Binding MissingEpisodeFinder.ConfirmDeleteSeriesCommand}"
                                                    Content="Confirm Delete"/>
                                            <Button Command="{Binding MissingEpisodeFinder.CancelDeleteSeriesCommand}"
                                                    Content="Cancel"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeriesSummary}" Opacity="0.78" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeriesCatalogSummary}" Opacity="0.78" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeriesMissingSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <Border Padding="12" CornerRadius="10" Background="{DynamicResource ThemeControlLowBrush}" IsVisible="{Binding MissingEpisodeFinder.SelectedSeries.HasMetadata, FallbackValue=False}">
                                    <StackPanel Spacing="6">
                                        <WrapPanel>
                                            <TextBlock Margin="0,0,8,0" Text="{Binding MissingEpisodeFinder.SelectedSeries.RatingText}" FontWeight="SemiBold" IsVisible="{Binding MissingEpisodeFinder.SelectedSeries.RatingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Margin="0,0,8,0" Text="{Binding MissingEpisodeFinder.SelectedSeries.Network}" Opacity="0.8" IsVisible="{Binding MissingEpisodeFinder.SelectedSeries.Network, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeries.SeriesStatus}" Opacity="0.8" IsVisible="{Binding MissingEpisodeFinder.SelectedSeries.SeriesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeries.GenreText}" FontSize="12" Opacity="0.72" TextWrapping="Wrap" IsVisible="{Binding MissingEpisodeFinder.SelectedSeries.GenreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeries.CatalogSummaryText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" IsVisible="{Binding MissingEpisodeFinder.SelectedSeries.CatalogSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Episode Preview" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeriesEpisodePreview}" TextWrapping="Wrap"/>
                                <Border Padding="12" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Missing Episodes" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeriesMissingEpisodePreview}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="12" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1"
                                        IsVisible="{Binding MissingEpisodeFinder.HasNzbResults}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Usenet Availability" FontWeight="Bold"/>
                                        <ItemsControl ItemsSource="{Binding MissingEpisodeFinder.NzbResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NzbEpisodeResultViewModel">
                                                    <DockPanel Margin="0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Padding="12" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Unparseable Files" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MissingEpisodeFinder.SelectedSeriesUnparseableSummary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="12" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Activity" FontWeight="Bold"/>
                                        <ItemsControl ItemsSource="{Binding MissingEpisodeFinder.ActivityLog}"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="12" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Errors" FontWeight="Bold"/>
                                        <ItemsControl ItemsSource="{Binding MissingEpisodeFinder.Errors}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="The desktop shell reuses the existing normalization core and is now structured to host multiple workflows inside the same window." Opacity="0.7"/>
    </Grid>

</Window>
